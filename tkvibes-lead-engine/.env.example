# ── Environment variables for TKVibes Lead Engine ────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env or real secrets to version control.

# ── Google APIs ──────────────────────────────────────────────────────────────
# Google Maps / Places API key (required for lead discovery)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Sheets integration (optional — needed only for reporting)
# The ID of the Google Sheet where leads will be written.
# From the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_IS_THE_ID>/edit
GOOGLE_SHEETS_ID=your_google_sheet_id_here

# Path to the Google service account JSON credentials file.
# Service account must have Editor access to the sheet above.
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google-service-account.json

# ── CRM Integration ─────────────────────────────────────────────────────────
# CRM API endpoint and shared secret key
# The API key MUST match the value in crm/config.local.php → api_key
CRM_API_KEY=your_crm_api_key_here
CRM_API_URL=https://tkvibes.in/crm

# ── GitHub ───────────────────────────────────────────────────────────────────
# Override the GitHub repo for raw URLs (auto-detected from git remote by default)
# Format: "owner/repo-name" (without .git)
GITHUB_REPO=takclawmachine-cpu/tkvibes-agency
GITHUB_BRANCH=main

# ── OpenAI / OpenRouter ──────────────────────────────────────────────────────
# OpenRouter API key — enables AI-powered website generation
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Security ─────────────────────────────────────────────────────────────────
# Force HTTPS for session cookies (set to false only for local development)
CRM_FORCE_HTTPS=true
