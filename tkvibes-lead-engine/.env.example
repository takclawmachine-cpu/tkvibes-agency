# ── Environment variables for TKVibes Lead Engine ────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env or real secrets to version control.

# Google Maps / Places API key (required)
# Get one at https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Sheets integration (required)
# The ID of the Google Sheet where leads will be written.
# From the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_IS_THE_ID>/edit
GOOGLE_SHEETS_ID=your_google_sheet_id_here

# Path to the Google service account JSON credentials file.
# Absolute path or path relative to the lead engine root.
# Service account must have Editor access to the sheet above.
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google-service-account.json

# Optional: override the GitHub repo for raw URLs (auto-detected from git remote by default)
# GITHUB_REPO=your-username/your-repo-name

# OpenRouter API key — enables AI-powered website generation
# Get one at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your_key_here